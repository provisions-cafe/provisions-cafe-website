# Copy this file to `.env.local` (which is gitignored) and fill in the values.
# ---------------------------------------------------------------------------

# Supabase — Project Settings → Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon public key>       # safe in the browser
SUPABASE_SERVICE_ROLE_KEY=<service role key>          # SERVER ONLY — never expose, never NEXT_PUBLIC_*

# Canonical site origin (already used by site-data.ts for SEO/canonical URLs).
NEXT_PUBLIC_SITE_URL=https://www.provisionscafewilliamstown.com

# Resend (transactional email: contact enquiries + booking notifications).
# https://resend.com/api-keys — SERVER ONLY, never NEXT_PUBLIC_*.
RESEND_API_KEY=
# Verified sender. Must be on a domain you've verified in Resend for production;
# until then Resend's onboarding@resend.dev only delivers to the account owner.
EMAIL_FROM=Provisions Cafe <info@provisionscafewilliamstown.com>
# Where enquiries + booking notifications are sent. Defaults to the contact
# email in Admin → Business info if left blank.
EMAIL_TO=williamstownprovisions@gmail.com
